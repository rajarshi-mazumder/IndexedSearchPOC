# Existing Salesforce CLI login; used only by indexing commands.
SF_TARGET_ORG=rajarshi

# AWS SDK default credential chain: AWS_PROFILE, SSO, environment, or an IAM role.
AWS_REGION=ap-northeast-1
AWS_PROFILE=default
OPENSEARCH_NODE=https://replace-collection-id.aoss.ap-northeast-1.on.aws

# Use a new index: the restored 768-dimensional BGE index is incompatible.
OPENSEARCH_INDEX=candidates-titan-v2
OPENSEARCH_INGEST_PIPELINE=candidate-titan-v2-ingest
OPENSEARCH_SEARCH_PIPELINE=candidate-titan-v2-hybrid

# Setup requires an IAM role that OpenSearch can assume to invoke Titan V2.
BEDROCK_ROLE_ARN=arn:aws:iam::123456789012:role/IndexedSearchBedrockRole

# Filled from npm run setup-opensearch output. This is the registered OpenSearch
# model ID, not the Bedrock model name amazon.titan-embed-text-v2:0.
OPENSEARCH_MODEL_ID=
