{
  "$schema": "../node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "cli": { "analytics": false, "cache": { "path": "../.cache/angular" } },
  "projects": { "candidate-console": {
    "projectType": "application", "root": "", "sourceRoot": "src",
    "architect": { "build": { "builder": "@angular/build:application", "options": {
      "outputPath": { "base": "../dist/ui", "browser": "" }, "browser": "src/main.ts", "index": "src/index.html",
      "tsConfig": "tsconfig.app.json", "styles": ["src/styles.scss"], "assets": [],
      "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false },
      "budgets": [{ "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }]
    } } }
  } }
}
