' IndexedSearch: three independent module flows.
' Each @startuml block renders a separate operational flow.
' The HTML groups fetch + CV under preparation, setup + indexing under embedding.
' Render all blocks with: java -jar plantuml.jar -charset UTF-8 -tsvg indexedSearchSystemOverview.puml

@startuml indexedSearchDataGenerationFetch

skinparam backgroundColor #0B1020
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam defaultFontColor #E7EDF8
skinparam ArrowColor #A2B2CA
skinparam ArrowFontColor #AABAD3
skinparam ArrowFontSize 12
skinparam activity {
  BackgroundColor #123241
  BorderColor #62D8EA
  FontColor #E7EDF8
  DiamondBackgroundColor #1C2940
  DiamondBorderColor #8192AF
  DiamondFontColor #E7EDF8
  StartColor #62D8EA
  EndColor #62D8EA
  BarColor #62D8EA
}
skinparam note {
  BackgroundColor #182237
  BorderColor #465773
  FontColor #B9C8DD
  FontSize 12
}
skinparam partition {
  BackgroundColor #0E1628
  BorderColor #364761
  FontColor #E7EDF8
}


start
#1D2A3E:<b>INPUT / UI or CLI</b>
Salesforce org, output dataset,
batch size, max batches, resume;
:Validate fetch request;
#1D2A3E:Acquire dataset lock;
#1D2A3E:Read existing checkpoint;
:Validate resume / start rules
and source extraction identity;
if (New checkpoint?) then (yes)
  #1D2A3E:Save initial checkpoint;
endif
while (Below batch limit,\nnot complete, not stopped?) is (yes)
  :Report next batch starting;
  #30271A:Authenticate / use Salesforce connection
and inspect supported schema;
  #30271A:Query next bounded Contact batch
after the saved Salesforce ID;
  -> core profiles;
  if (Profiles returned?) then (yes)
    #30271A:Fetch candidate TagAssociation__c records;
    -> firstTag__c / secondTag__c IDs;
    :Collect unique tag IDs;
    while (Unresolved parent levels remain?) is (yes)
      :Check hierarchy depth / size limits;
      #30271A:Fetch Tag__c records and record types;
      :Collect unrequested parent tag IDs;
    endwhile (no)
    #30271A:Fetch Account / employer details
for unique referenced employers;
    -> profiles + associations + tags + employers;
    :Group associations by candidate ID;
    :Combine source fields and relationships
into candidate profiles;
    :Keep missing-field / unresolved-reference
warnings as diagnostics;
    :Validate batch size and cursor advancement;
    #1D2A3E:<b>Write candidate batch JSON atomically</b>
batch-000001.json, batch-000002.json, ...;
    :Calculate and report batch quality;
    :Calculate next cursor, totals
and completion state;
    #1D2A3E:<b>Save updated checkpoint</b>
Only after the candidate file was saved;
    :Report committed file and progress;
  else (no)
    :Mark extraction complete;
    #1D2A3E:Save completed checkpoint;
  endif
endwhile (no)
#1D2A3E:Release dataset lock;
#1D2A3E:<b>OUTPUT / host</b>
Saved batch files + resumable checkpoint
Fetched count, last batch, completion status;
stop
note right
  Console progress and results are saved
  in operation history. A failed batch
  does not advance its checkpoint.
end note

@enduml

@startuml indexedSearchDataGenerationCv

skinparam backgroundColor #0B1020
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam defaultFontColor #E7EDF8
skinparam ArrowColor #A2B2CA
skinparam ArrowFontColor #AABAD3
skinparam ArrowFontSize 12
skinparam activity {
  BackgroundColor #123241
  BorderColor #62D8EA
  FontColor #E7EDF8
  DiamondBackgroundColor #1C2940
  DiamondBorderColor #8192AF
  DiamondFontColor #E7EDF8
  StartColor #62D8EA
  EndColor #62D8EA
  BarColor #62D8EA
}
skinparam note {
  BackgroundColor #182237
  BorderColor #465773
  FontColor #B9C8DD
  FontSize 12
}
skinparam partition {
  BackgroundColor #0E1628
  BorderColor #364761
  FontColor #E7EDF8
}


start
#1D2A3E:<b>INPUT / console</b>
Selected batch filenames, action, seed;
#1D2A3E:Acquire dataset lock;
:Sort selected filenames;
if (Preview action?) then (yes)
  :Select first file only;
else (no)
  :Select all requested files;
endif
while (Files remain and not stopped?) is (yes)
  #1D2A3E:Read the next candidate JSON file;
  if (Preview action?) then (yes)
    :Select first 20 candidates;
  else (no)
    :Select all candidates in this file;
  endif
  while (Candidates remain?) is (yes)
    :Clone the next candidate;
    if (Remove action?) then (yes)
      :Remove CV only when synthetic;
      :If removed, retain cvProfileRemoved marker;
    else (no)
      if (CV absent, regenerate or preview?) then (yes)
        :Select template from source evidence
or deterministic hash fallback;
        :Generate summary, skills, employment,
projects, education, training and languages
using candidate ID + seed + version;
        :Attach synthetic CV metadata
and clear removal marker;
      else (no)
        :Keep existing CV unchanged;
      endif
    endif
    :Collect transformed candidate
and changed / skipped counts;
  endwhile (no)
  if (Preview action?) then (yes)
    :Collect preview results; no writes;
  else (no)
    if (File contains changes?) then (yes)
      #1D2A3E:Back up original candidate file;
      #1D2A3E:Atomically save transformed candidate JSON;
    endif
  endif
  :Report file progress and totals;
  :Allow pending Stop request;
endwhile (no)
#1D2A3E:Release dataset lock;
#1D2A3E:<b>OUTPUT / console + history</b>
Preview OR changed files + backups
Changed, skipped and completed-file counts;
stop
note right
  Preview reports zero persisted changes.
  Modified files reach OpenSearch only
  when the user starts embedding later.
end note

@enduml

