skinparam partition {
  BackgroundColor #0E1628
  BorderColor #364761
  FontColor #E7EDF8
}


start
#1D2A3E:<b>INPUT / UI or CLI</b>
Selected candidate JSON files
Target index + ingest pipeline + model;
:Sort selected files;
while (Files remain and not stopped?) is (yes)
  #1D2A3E:Validate committed file and capture fingerprint;
  #1D2A3E:Acquire dataset lock and load candidates;
  :Report initial candidate count;
  while (Candidate groups remain?) is (yes)
    if (Stop requested?) then (yes)
      #472535:Stop after completed bulk batch;
      :Release lock; return stopped operation
Rerun this file to finish;
      stop
    endif
    :Take next group of at most 100 candidates;
    while (Candidates remain in group?) is (yes)
      :Normalize candidate and deduplicate skills;
      :Format professional details + optional CV;
      :Generate and trim embedding searchText;
      if (Searchable text present?) then (yes)
        :Generate display / lexical profile;
        :Assemble document with stable Salesforce ID,
candidate, profile and searchText;
        :Add indexedAt using injected clock;
        :Append document to prepared group;
      else (no)
        if (CV removal marker present?) then (yes)
          :Collect stale document ID for deletion;
        else (no)
          :Count candidate as skipped;
        endif
      endif
    endwhile (no)
    #30271A:Delete collected stale document IDs;
    #30271A:Read / verify enriched index mapping when required;
    repeat
    #30271A:Send pending bulk upserts with selected ingest pipeline
Use Salesforce ID as document _id;
    #30271A:Ingest processor sends searchText
to registered model / Bedrock connector;
    #30271A:Bedrock Titan V2 generates
a 1,024-dimensional document vector;
    #30271A:Ingest processor attaches embedding;
    #30271A:OpenSearch stores fields, profile,
enrichment source and embedding vector;
    if (One acknowledgement per submitted item?) then (yes)
      :Inspect every bulk item result;
    else (no)
      #472535:Fail incomplete acknowledgement
Release lock; return operation error;
      stop
    endif
    if (Permanent error or retries exhausted?) then (yes)
      #472535:Fail operation and release lock
Some documents may already be indexed;
      stop
    endif
    :Select only transient failed items for retry
429 / 502 / 503 / 504;
    if (Retry items remain?) then (yes)
      :Wait 1, 2 or 4 seconds
At most 4 total attempts;
    endif
    repeat while (Retry items remain?) is (yes) not (no)
    note right
      Successful items are never retried.
      Delete requests use the same retry policy.
      Re-running uses the same document IDs.
    end note
    :Report processed / indexed / skipped counts;
  endwhile (no)
  #1D2A3E:Release dataset lock;
  #1D2A3E:Read file fingerprint again;
  if (Source file changed?) then (yes)
    #472535:Fail file verification; request retry;
    stop
  endif
  :Return per-file result and fingerprint
including deleted count when present;
endwhile (no)
#1D2A3E:<b>OUTPUT / host</b>
Indexed documents + vectors in chosen index
Per-file results and console operation history;
stop

