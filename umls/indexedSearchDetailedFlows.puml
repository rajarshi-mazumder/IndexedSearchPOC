@startuml indexedSearchDataSearch

skinparam backgroundColor #0B1020
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam defaultFontColor #E7EDF8
skinparam ArrowColor #A2B2CA
skinparam ArrowFontColor #AABAD3
skinparam ArrowFontSize 12
skinparam activity {
  BackgroundColor #163C33
  BorderColor #68DEC0
  FontColor #E7EDF8
  DiamondBackgroundColor #1C2940
  DiamondBorderColor #8192AF
  DiamondFontColor #E7EDF8
  StartColor #68DEC0
  EndColor #68DEC0
  BarColor #68DEC0
}
skinparam note {
  BackgroundColor #182237
  BorderColor #465773
  FontColor #B9C8DD
  FontSize 12
}
skinparam partition {
  BackgroundColor #0E1628
  BorderColor #364761
  FontColor #E7EDF8
}


start
#1D2A3E:<b>INPUT / UI or CLI</b>
Query text, result limit, selected index
Configured OpenSearch model ID;
:Trim and validate query (1-10,000 characters)
Validate integer result limit (1-100);
:Calculate branch pool size
max(requested limit x 3, 50);
:Set both requests to bypass search pipelines
search_pipeline = "_none"
allow_partial_search_results = false;
fork
  :Build lexical multi_match request
cross_fields; minimum_should_match = "2<30%";
  note left
    skills^10, title^8, jobFunctions^6,
    systems^5, skillCategories^4, profile.
    Profile includes optional CV text.
  end note
  #30271A:OpenSearch matches query against
boosted fields and profile;
  #30271A:Return up to pool-size lexical hits
with original scores and source documents;
  :Reject timeout / failed shards;
  :Restore candidate documents
Keep raw lexical scores and response order;
fork again
  :Build neural query over embedding
Use configured model ID; k = pool size;
  #30271A:OpenSearch sends query text through
registered model / Bedrock connector;
  #30271A:Bedrock Titan V2 generates
a 1,024-dimensional query vector;
  #30271A:OpenSearch retrieves vector neighbors
from the selected candidate index;
  #30271A:Return up to pool-size vector hits
with original scores and source documents;
  :Reject timeout / failed shards;
  :Restore candidate documents
Keep raw vector scores and response order;
end fork
if (Both requests succeeded completely?) then (yes)
  :Merge both lists by Salesforce ID;
else (no)
  #472535:Fail the entire search
Do not rank a partial branch result;
  stop
endif
:Record one-based positions and raw scores
First occurrence per branch wins;
:Keep lexical document when present in both
Missing branch rank / score stays null;
:Calculate equal-weight reciprocal rank fusion
1/(60 + lexical position) + 1/(60 + vector position)
Missing branch contributes zero;
:Sort by descending RRF score
Break ties by ascending Salesforce ID;
:Apply requested final result limit;
#1D2A3E:Host maps result metadata
Assign final rank 1, 2, 3, ...;
#1D2A3E:<b>OUTPUT / Angular table or CLI</b>
Candidate profile, rank, RRF score
Raw lexical / vector scores + positions;
#1D2A3E:Console saves operation and complete result
for history and later inspection;
stop
note right
  RRF is an ordering score, not confidence.
  There is no suitability acceptance threshold
  or reranker in the current implementation.
end note

@enduml
